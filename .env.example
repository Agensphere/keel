# Postgres
KEEL_DATABASE_URL=postgres://keel@127.0.0.1:5432/keel

# Azure AI Foundry (OpenAI-compatible). Leave KEEL_AZURE_API_VERSION empty to use the v1 API
# ({endpoint}/openai/v1/chat/completions); set it to use /openai/deployments/{d}/chat/completions.
KEEL_AZURE_ENDPOINT=https://<resource>.openai.azure.com
KEEL_AZURE_API_KEY=
KEEL_AZURE_API_VERSION=
# Model aliases used by workflows -> deployment name[, USD per 1M input, USD per 1M output]
KEEL_MODEL_PRIMARY=gpt-4.1,2.00,8.00
KEEL_MODEL_ALT=gpt-4.1-mini,0.40,1.60
# KEEL_LLM=scripted   # force the scripted model (no Azure needed)

# Stripe TEST mode only (sk_test_… or a restricted rk_test_… key with PaymentIntents + Refunds write).
# Unset to use the local fake: `keel demo fake-stripe`.
STRIPE_SECRET_KEY=

# Demo
KEEL_ORDERS=demo/orders.json
KEEL_LEASE_MS=30000
KEEL_LOG=warn
